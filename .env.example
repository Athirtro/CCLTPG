# Propósito: ejemplo de variables de entorno para desarrollo local (sin secretos).
# Completar valores reales en .env (no versionado).

# API
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Base de datos (PostgreSQL 16)
DATABASE_URL=postgresql://ccltpg_app:change_me@localhost:5432/ccltpg
DATABASE_MIGRATOR_URL=postgresql://ccltpg_migrator:change_me@localhost:5432/ccltpg
DATABASE_READONLY_URL=postgresql://ccltpg_readonly:change_me@localhost:5432/ccltpg

# Redis
REDIS_URL=redis://localhost:6379

# Almacenamiento de objetos (S3 compatible / MinIO en desarrollo)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ccltpg
OBJECT_STORAGE_ACCESS_KEY=change_me
OBJECT_STORAGE_SECRET_KEY=change_me

# Seguridad (valores de ejemplo; gestionar secretos fuera del repositorio)
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
MFA_ISSUER=CCLTPG

# Observabilidad
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

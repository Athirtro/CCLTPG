# Propósito: ejemplo de variables de entorno para desarrollo local (sin secretos).
# Copiar a .env (no versionado) y completar con los valores de infra/compose/.env.

# API
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=1mb
HEALTH_TIMEOUT_MS=2000
TRUST_PROXY=false

# Base de datos (PostgreSQL 16)
# El rol de aplicación no puede ejecutar DDL: las migraciones usan DATABASE_MIGRATOR_URL.
DATABASE_URL=postgresql://ccltpg_app:change_me_local_only@localhost:5432/ccltpg
DATABASE_MIGRATOR_URL=postgresql://ccltpg_migrator:change_me_local_only@localhost:5432/ccltpg
DATABASE_READONLY_URL=postgresql://ccltpg_readonly:change_me_local_only@localhost:5432/ccltpg

# Redis
REDIS_URL=redis://localhost:6379

# Almacenamiento de objetos (S3 compatible / MinIO en desarrollo)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ccltpg
OBJECT_STORAGE_ACCESS_KEY=ccltpg_minio
OBJECT_STORAGE_SECRET_KEY=change_me_local_only

# Seguridad (valores de ejemplo; la autenticación se implementa en C2)
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
MFA_ISSUER=CCLTPG

# Frontend (Vite). Si se omite, la SPA usa el proxy /api/v1 de Vite.
VITE_API_BASE_URL=/api/v1

# Observabilidad
OTEL_EXPORTER_OTLP_ENDPOINT=

# Copiar a infra/compose/.env (no versionado) y cambiar los valores.
# Este archivo no contiene secretos reales.

POSTGRES_DB=ccltpg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_only

# Roles de aplicación (los crea postgres/init/00-roles.sql al inicializar el volumen)
CCLTPG_MIGRATOR_PASSWORD=change_me_local_only
CCLTPG_APP_PASSWORD=change_me_local_only
CCLTPG_READONLY_PASSWORD=change_me_local_only

POSTGRES_PORT=5432
REDIS_PORT=6379

MINIO_ROOT_USER=ccltpg_minio
MINIO_ROOT_PASSWORD=change_me_local_only
MINIO_BUCKET=ccltpg
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

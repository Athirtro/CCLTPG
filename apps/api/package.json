{
  "name": "@ccltpg/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend NestJS de CCLTPG (esqueleto caminante de la Iteración 1).",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src test/api",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:architecture": "vitest run test/architecture",
    "migrate:up": "tsx src/database/migrator/migrate.ts up",
    "migrate:down": "tsx src/database/migrator/migrate.ts down",
    "migrate:status": "tsx src/database/migrator/migrate.ts status",
    "db:seed": "tsx src/database/seeds/run.ts",
    "openapi:generate": "tsx src/openapi/generate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-ioredis": "0.73.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/sdk-node": "0.301.2",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "exceljs": "4.4.0",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "nestjs-pino": "5.3.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "9.39.5",
    "multer": "2.5.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
